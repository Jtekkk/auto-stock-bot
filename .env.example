# Copy to .env and fill in for live/paper trading against Alpaca.
# The backtester and offline demo need NONE of these.

# Alpaca API credentials (use PAPER keys — https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper endpoint by default. Only change to the live URL if you truly mean real money.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
